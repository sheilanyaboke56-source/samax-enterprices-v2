<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Samax Enterprises | Admin Portal</title>

<style>
:root {
  --green: #174a35;
  --dark: #0d3325;
  --gold: #d6b04c;
  --cream: #f8f6ef;
  --white: #ffffff;
  --ink: #18241e;
  --muted: #6d776f;
  --line: #e4e8e1;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--cream);
  color: var(--ink);
}

header {
  background: var(--green);
  color: white;
  padding: 20px;
  border-bottom: 4px solid var(--gold);
}

.brand {
  font-size: 24px;
  font-weight: bold;
}

.brand span { color: var(--gold); }

header p {
  margin: 5px 0 0;
  color: #e8e8e8;
}

main {
  max-width: 1150px;
  margin: 30px auto;
  padding: 0 18px;
}

.panel {
  background: white;
  padding: 22px;
  margin-bottom: 22px;
  border-radius: 13px;
  box-shadow: 0 3px 14px #0000000b;
}

h2 { color: var(--green); }

input, select, textarea {
  width: 100%;
  padding: 12px;
  margin: 7px 0 15px;
  border: 1px solid var(--line);
  border-radius: 7px;
  font-size: 15px;
}

label {
  font-weight: bold;
  font-size: 14px;
}

button {
  background: var(--green);
  color: white;
  border: 0;
  padding: 12px 17px;
  border-radius: 7px;
  cursor: pointer;
  margin: 4px;
}

button:hover { background: var(--dark); }

.gold-button {
  background: var(--gold);
  color: var(--dark);
  font-weight: bold;
}

.danger { background: #a83232; }

.stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 15px;
}

.stat {
  background: var(--cream);
  border: 1px solid var(--line);
  padding: 18px;
  border-radius: 10px;
}

.stat strong {
  display: block;
  font-size: 28px;
  color: var(--green);
  margin-top: 8px;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 550px;
}

th, td {
  text-align: left;
  padding: 12px;
  border-bottom: 1px solid var(--line);
}

th {
  background: var(--green);
  color: white;
}

.table-wrap { overflow-x: auto; }

#dashboard, #login { display: none; }

#message {
  color: #a83232;
  font-weight: bold;
}

#notice {
  margin: 12px 0;
  color: var(--green);
}

footer {
  text-align: center;
  padding: 25px;
  color: var(--muted);
}

@media(max-width: 600px) {
  main { margin: 18px auto; }
  .panel { padding: 15px; }
}
</style>
</head>

<body>

<header>
  <div class="brand">SAMAX <span>ENTERPRISES</span></div>
  <p>Private Shop Administration Portal</p>
</header>

<main>

<section id="login" class="panel">
  <h2>Administrator Login</h2>
  <p>Sign in to manage your Samax shop.</p>

  <form id="loginForm">
    <label>Email address</label>
    <input id="email" type="email" required>

    <label>Password</label>
    <input id="password" type="password" required>

    <button type="submit">Sign in</button>
  </form>
  <p id="message"></p>
</section>

<section id="dashboard">

  <div class="panel toolbar">
    <div>
      <h2>Welcome to your dashboard</h2>
      <p id="adminEmail"></p>
    </div>
    <button id="logout">Sign out</button>
  </div>

  <section class="panel">
    <h2>Shop Overview</h2>
    <div class="stats">
      <div class="stat">
        Products
        <strong id="productCount">0</strong>
      </div>
      <div class="stat">
        Orders
        <strong id="orderCount">0</strong>
      </div>
      <div class="stat">
        Pending orders
        <strong id="pendingCount">0</strong>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>Add a Product</h2>

    <form id="productForm">
      <label>Product name</label>
      <input id="productName" required>

      <label>Category</label>
      <select id="productCategory" required>
        <option value="">Choose category</option>
        <option>Food & groceries</option>
        <option>Household essentials</option>
        <option>Kitchenware</option>
        <option>Cleaning supplies</option>
        <option>Personal care & toiletries</option>
        <option>Stationery & school supplies</option>
        <option>Electronics & accessories</option>
        <option>Clothing & accessories</option>
        <option>Baby & kids' products</option>
        <option>Hardware & tools</option>
        <option>Beverages</option>
        <option>Other products</option>
      </select>

      <label>Price (KES)</label>
      <input id="productPrice" type="number" min="0" step="0.01" required>

      <label>Stock quantity</label>
      <input id="productStock" type="number" min="0" step="1" required>

      <label>Product image URL (optional)</label>
      <input id="productImage" type="url">

      <label>Description</label>
      <textarea id="productDescription" rows="3"></textarea>

      <label>
        <input id="productPopular" type="checkbox" style="width:auto">
        Mark as popular product
      </label>

      <br>
      <button class="gold-button" type="submit">Add Product</button>
    </form>

    <p id="productMessage"></p>
  </section>

  <section class="panel">
    <div class="toolbar">
      <h2>My Products</h2>
      <button onclick="loadProducts()">Refresh products</button>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="productsTable"></tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <div class="toolbar">
      <h2>Customer Orders</h2>
      <button onclick="loadOrders()">Refresh orders</button>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Customer</th>
            <th>Phone</th>
            <th>Total</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="ordersTable"></tbody>
      </table>
    </div>
    <p id="orderMessage"></p>
  </section>

</section>
</main>

<footer>© Samax Enterprises</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
const SUPABASE_URL =
  "https://htqzicbmlwwlycvtcfvy.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_m9bc6NYfuinVNfOJ6lq3-w_C_V9Fgi4";

const db = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

const login = document.getElementById("login");
const dashboard = document.getElementById("dashboard");

async function checkAdmin() {
  const { data: { user } } = await db.auth.getUser();

  if (!user) {
    login.style.display = "block";
    dashboard.style.display = "none";
    return;
  }

  const { data, error } = await db
    .from("user_roles")
    .select("role")
    .eq("user_id", user.id)
    .maybeSingle();

  if (error || !data || data.role !== "admin") {
    await db.auth.signOut();
    login.style.display = "block";
    dashboard.style.display = "none";
    document.getElementById("message").textContent =
      "This account does not have admin permission.";
    return;
  }

  login.style.display = "none";
  dashboard.style.display = "block";
  document.getElementById("adminEmail").textContent =
    "Signed in as: " + user.email;

  await loadProducts();
  await loadOrders();
}

document.getElementById("loginForm")
.addEventListener("submit", async function(event) {
  event.preventDefault();

  const message = document.getElementById("message");
  message.textContent = "Signing in...";

  const { error } = await db.auth.signInWithPassword({
    email: document.getElementById("email").value,
    password: document.getElementById("password").value
  });

  if (error) {
    message.textContent = error.message;
    return;
  }

  await checkAdmin();
});

document.getElementById("logout")
.addEventListener("click", async function() {
  await db.auth.signOut();
  await checkAdmin();
});

document.getElementById("productForm")
.addEventListener("submit", async function(event) {
  event.preventDefault();

  const message = document.getElementById("productMessage");
  message.textContent = "Saving product...";

  const product = {
    name: document.getElementById("productName").value.trim(),
    category: document.getElementById("productCategory").value,
    price: Number(document.getElementById("productPrice").value),
    stock_quantity: Number(document.getElementById("productStock").value),
    image_url: document.getElementById("productImage").value.trim() || null,
    description: document.getElementById("productDescription").value.trim(),
    is_active: true,
    is_popular: document.getElementById("productPopular").checked
  };

  const { error } = await db.from("products").insert(product);

  if (error) {
    message.textContent = "Could not add product: " + error.message;
    return;
  }

  message.textContent = "Product added successfully!";
  document.getElementById("productForm").reset();
  await loadProducts();
});

async function loadProducts() {
  const { data, error } = await db
    .from("products")
    .select("id, name, price, stock_quantity")
    .order("name");

  if (error) {
    document.getElementById("productsTable").innerHTML =
      "<tr><td colspan='4'>Could not load products: " +
      error.message + "</td></tr>";
    return;
  }

  document.getElementById("productCount").textContent = data.length;

  const table = document.getElementById("productsTable");
  table.innerHTML = "";

  data.forEach(product => {
    const tr = document.createElement("tr");

    const name = document.createElement("td");
    name.textContent = product.name;

    const price = document.createElement("td");
    price.textContent = "KES " + Number(product.price).toLocaleString();

    const stock = document.createElement("td");
    stock.textContent = product.stock_quantity;

    const actions = document.createElement("td");

    const edit = document.createElement("button");
    edit.textContent = "Edit";
    edit.addEventListener("click", () => editProduct(product));

    const remove = document.createElement("button");
    remove.textContent = "Delete";
    remove.className = "danger";
    remove.addEventListener("click", () => deleteProduct(product.id));

    actions.append(edit, remove);
    tr.append(name, price, stock, actions);
    table.appendChild(tr);
  });
}

async function editProduct(product) {
  const newPrice = prompt("Enter the new price (KES):", product.price);
  if (newPrice === null) return;

  const price = Number(newPrice);
  if (!Number.isFinite(price) || price < 0) {
    alert("Please enter a valid price.");
    return;
  }

  const newStock = prompt("Enter the new stock quantity:", product.stock_quantity);
  if (newStock === null) return;

  const stock = Number(newStock);
  if (!Number.isInteger(stock) || stock < 0) {
    alert("Please enter a valid whole-number stock quantity.");
    return;
  }

  const { error } = await db
    .from("products")
    .update({ price, stock_quantity: stock })
    .eq("id", product.id);

  if (error) {
    alert("Update failed: " + error.message);
  } else {
    await loadProducts();
  }
}

async function deleteProduct(id) {
  if (!confirm("Are you sure you want to delete this product?")) return;

  const { error } = await db.from("products").delete().eq("id", id);

  if (error) {
    alert("Delete failed: " + error.message);
  } else {
    await loadProducts();
  }
}

async function loadOrders() {
  const table = document.getElementById("ordersTable");
  const message = document.getElementById("orderMessage");

  const { data, error } = await db
    .from("orders")
    .select("id, customer_name, customer_phone, total_amount, order_status")
    .order("created_at", { ascending: false });

  if (error) {
    message.textContent = "Could not load orders: " + error.message;
    return;
  }

  message.textContent = "";
  document.getElementById("orderCount").textContent = data.length;
  document.getElementById("pendingCount").textContent =
    data.filter(order => order.order_status === "pending").length;

  table.innerHTML = "";

  data.forEach(order => {
    const tr = document.createElement("tr");

    const customer = document.createElement("td");
    customer.textContent = order.customer_name;

    const phone = document.createElement("td");
    phone.textContent = order.customer_phone;

    const total = document.createElement("td");
    total.textContent = "KES " + Number(order.total_amount).toLocaleString();

    const statusCell = document.createElement("td");
    const status = document.createElement("select");

    ["pending", "processing", "shipped", "delivered", "cancelled"]
      .forEach(value => {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = value;
        status.appendChild(option);
      });

    status.value = order.order_status;
    status.addEventListener("change", async () => {
      const { error } = await db
        .from("orders")
        .update({ order_status: status.value })
        .eq("id", order.id);

      if (error) {
        alert("Could not update order: " + error.message);
        status.value = order.order_status;
      } else {
        order.order_status = status.value;
        document.getElementById("pendingCount").textContent =
          data.filter(item => item.order_status === "pending").length;
      }
    });

    statusCell.appendChild(status);
    tr.append(customer, phone, total, statusCell);
    table.appendChild(tr);
  });
}

checkAdmin();
</script>

</body>
</html>
